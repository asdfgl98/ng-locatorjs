{
  "name": "ng-locator",
  "version": "0.1.0",
  "description": "Click any Angular component to open its source code in your IDE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ng-locator-scan": "dist/cli.js",
    "ng-locator-server": "dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "typesVersions": {
    "*": {
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@angular/core": ">=14.0.0"
  },
  "keywords": [
    "angular",
    "locator",
    "locatorjs",
    "devtools",
    "ide",
    "cursor",
    "vscode"
  ],
  "author": "asdfgl98",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/asdfgl98/ng-locatorjs"
  },
  "bugs": {
    "url": "https://github.com/asdfgl98/ng-locatorjs/issues"
  },
  "homepage": "https://github.com/asdfgl98/ng-locatorjs#readme"
}
